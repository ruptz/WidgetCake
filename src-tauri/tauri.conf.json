{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WidgetCake",
  "version": "0.0.1",
  "identifier": "com.widgetcake.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WidgetCake",
        "width": 1110,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#101114",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
